    {
      "id": "notes",
      "type": "text",
      "x": 1061.25,
      "y": 145.5,
      "width": 256.22772216796875,
      "height": 105,
      "angle": 0,
      "strokeColor": "#757575",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 448461497,
      "version": 39,
      "versionNonce": 1008019570,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772382168426,
      "link": null,
      "locked": false,
      "text": "1. Reads and writes are separated\n2. Users never wait for scraping\n3. Cron runs every 6h (configurable)\n4. Stale data is replaced on each run\n5. scrape_runs tracks health/errors\n6. search_logs help understand usage",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Reads and writes are separated\n2. Users never wait for scraping\n3. Cron runs every 6h (configurable)\n4. Stale data is replaced on each run\n5. scrape_runs tracks health/errors\n6. search_logs help understand usage",
      "autoResize": true,
      "lineHeight": 1.25
    },
